# Copy this file to ".env" and fill in your Supabase project credentials.
# Find them in your Supabase dashboard: Project Settings → API.
# The anon key is safe to expose in a frontend — it's protected by Row-Level Security.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# The origin this deployment is served from. Used for canonical tags, og:url,
# JSON-LD and the generated sitemap. Set it to your own domain: leaving it
# pointing somewhere else tells search engines the canonical version of your
# pages lives on that other site. Defaults to http://localhost:5173.
VITE_SITE_URL=https://your-domain.example
